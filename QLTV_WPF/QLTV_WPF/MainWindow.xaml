<Window x:Class="QLTV_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QLTV_WPF"
        mc:Ignorable="d"
        Title="Quản Lý Thư Viện " Height="450" Width="800 
        ">
    <StackPanel Margin="0,12,10,14">
        <Menu VerticalAlignment="Top" Background="White" Padding="5">
            <MenuItem Header="Danh mục Sách">
                <MenuItem Header="Quản lý Loại Sách" Click="MenuItemLS_Click"/>
                <MenuItem Header="Quản lý Sách" Click="MenuItem_ClickSach"/>
                <Separator />
                <MenuItem Header="Quản lý Tác Giả" Click="QLTacGia_Click"/>
                <MenuItem Header="Quản lý Nhà Xuất Bản" Click="QLNhaXuatBan_Click"/>
            </MenuItem>

            <MenuItem Header="Quản lý Đối tượng">
                <MenuItem Header="Quản lý Độc Giả" Click="QLDocGia_Click"/>
                <MenuItem Header="Quản lý Nhân Viên" Click="QLNhanVien_Click"/>
            </MenuItem>

            <MenuItem Header="Nghiệp vụ Mượn/Trả">
                <MenuItem Header="Lập Phiếu Mượn" Click="QLPhieuMuon_Click"/>
                <MenuItem Header="Lập Phiếu Trả" Click="QLPhieuTra_Click"/>
                <Separator />
                <MenuItem Header="Chi Tiết Mượn" Click="QLChiTietMuon_Click"/>
                <MenuItem Header="Sách Đang Mượn" Click="MenuItem_ClickSachMuon"/>
            </MenuItem>

            <!--<MenuItem Header="Hệ thống">
                <MenuItem Header="Đăng xuất" />
                <MenuItem Header="Thoát" Click="Close"/>
            </MenuItem>-->
        </Menu>
    </StackPanel>
</Window>
