<Window x:Class="QLTV_WPF.UI.QL_PhieuMuon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Phiếu Mượn" Height="600" Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <TextBlock Text="QUẢN LÝ PHIẾU MƯỢN"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- FORM -->
        <Border Grid.Row="1" Background="#F9FBFF" CornerRadius="8" Padding="15" Margin="0,5" BorderBrush="#D0D7E2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Mã phiếu mượn:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5"/>
                <TextBox Grid.Row="0" Grid.Column="1" Height="30" Margin="5" IsReadOnly="True" Background="#F0F0F0" VerticalContentAlignment="Center"
                         Text="{Binding Selected.MaPhieuMuon}"/>

                <TextBlock Text="Độc giả:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="10,0,0,0"/>
                <ComboBox Grid.Row="0" Grid.Column="3" Height="30" Margin="5" 
          ItemsSource="{Binding ListDocGia}" 
          DisplayMemberPath="HoTen" 
          SelectedValuePath="MaDocGia" 
          SelectedValue="{Binding MaDocGia, UpdateSourceTrigger=PropertyChanged}"
          
          IsEditable="True"
          StaysOpenOnEdit="True"
          IsTextSearchEnabled="False"
          Text="{Binding TuKhoaDocGia, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Nhân viên lập:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Height="30" Margin="5" 
                          ItemsSource="{Binding ListNhanVien}" DisplayMemberPath="HoTen" SelectedValuePath="MaNv" 
                          SelectedValue="{Binding MaNhanVien, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Ngày mượn:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="10,0,0,0"/>
                <DatePicker Grid.Row="1" Grid.Column="3" Height="30" Margin="5"
                            SelectedDate="{Binding NgayMuon, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Ngày trả dự kiến:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5"/>
                <DatePicker Grid.Row="2" Grid.Column="1" Height="30" Margin="5"
                            SelectedDate="{Binding NgayTra, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Ghi chú:" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="10,0,0,0"/>
                <TextBox Grid.Row="2" Grid.Column="3" Height="30" Margin="5" VerticalContentAlignment="Center"
                         Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Ô tìm kiếm tự động -->
                <TextBlock Text="Tìm kiếm:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5"/>
                <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="5">
                    <TextBox Height="30" VerticalContentAlignment="Center" Padding="5,0"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="🔎  Nhập mã phiếu, tên nhân viên, tên độc giả hoặc ghi chú..."
                               VerticalAlignment="Center" Margin="7,0,0,0"
                               Foreground="#AAAAAA" FontStyle="Italic" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Keyword}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Keyword}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- BUTTON + GRID -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BUTTON -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button Content="➕ Thêm" Width="120" Height="35" Margin="5"
                        Background="#27AE60" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdthem}"/>

                <Button Content="✏️ Sửa" Width="120" Height="35" Margin="5"
                        Background="#F39C12" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdsua}"/>

                <Button Content="🗑 Xóa" Width="120" Height="35" Margin="5"
                        Background="#E74C3C" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdxoa}"/>

                <Button Content="🔄 Làm mới" Width="120" Height="35" Margin="5"
                        Background="#3498DB" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdlammoi}"/>
            </StackPanel>

            <!-- DATAGRID -->
            <DataGrid Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      ItemsSource="{Binding ListHienThi}"
                      SelectedItem="{Binding SelectedHienThi}"
                      Background="White"
                      BorderBrush="#D0D7E2">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã phiếu mượn" Binding="{Binding MaPhieuMuon}" Width="120"/>
                    <DataGridTextColumn Header="Nhân viên lập" Binding="{Binding TenNhanVien}" Width="180"/>
                    <DataGridTextColumn Header="Độc giả" Binding="{Binding TenDocGia}" Width="180"/>
                    <DataGridTextColumn Header="Ngày mượn" Binding="{Binding NgayMuon, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
                    <DataGridTextColumn Header="Ngày trả dự kiến" Binding="{Binding NgayTra, StringFormat={}{0:dd/MM/yyyy}}" Width="140"/>
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*"/>
                </DataGrid.Columns>

            </DataGrid>
        </Grid>
    </Grid>
</Window>