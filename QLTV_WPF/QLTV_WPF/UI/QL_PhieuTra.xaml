<Window x:Class="QLTV_WPF.UI.QL_PhieuTra"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Phiếu Trả" Height="650" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="QUẢN LÝ PHIẾU TRẢ &amp; THU HỒI" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <TabControl Grid.Row="1">
            <TabItem Header="📥 TRẢ SÁCH MỚI">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                        <TextBlock Text="Mã Phiếu Mượn cũ:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                        <TextBox Width="150" Height="30" Text="{Binding MaPhieuMuonTimKiem, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="🔍 Tìm kiếm phiếu mượn" Width="150" Margin="10,0,0,0" Background="#34495E" Foreground="White" Command="{Binding cmdTimSachNo}" IsDefault="True"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding ListSachNo}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Chọn trả" Binding="{Binding IsChon, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="Mã sách" Binding="{Binding ChiTietGoc.MaSachMuon}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Tiền phạt" Binding="{Binding TienPhat, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="Lý do phạt" Binding="{Binding LyDoPhat, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Background="#F9FBFF" Padding="10" Margin="0,10,0,0" CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Nhân viên thu hồi:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox Width="150" ItemsSource="{Binding ListNhanVien}" DisplayMemberPath="HoTen" SelectedValuePath="MaNv" SelectedValue="{Binding MaNhanVien}"/>
                            <TextBlock Text="Ghi chú:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                            <TextBox Width="200" Text="{Binding GhiChu}"/>
                            <Button Content="📥 XÁC NHẬN TRẢ SÁCH" Width="200" Margin="20,0,0,0" Background="#27AE60" Foreground="White" FontWeight="Bold" Command="{Binding cmdChotTraSach}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="📜 LỊCH SỬ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox Height="30" Margin="0,0,0,10" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Tag="Nhập mã phiếu trả để tìm..."/>
                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding ListHienThi}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã Phiếu Trả" Binding="{Binding MaPhieuTra}" Width="120"/>
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding TenNhanVien}" Width="200"/>
                            <DataGridTextColumn Header="Ngày trả" Binding="{Binding NgayTra, StringFormat={}{0:dd/MM/yyyy}}" Width="150"/>
                            <DataGridTextColumn Header="Tổng phạt" Binding="{Binding TongTienPhat, StringFormat={}{0:N0} đ}" Width="150"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>