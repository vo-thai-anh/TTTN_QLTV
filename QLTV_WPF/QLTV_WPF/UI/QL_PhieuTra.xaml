<Window x:Class="QLTV_WPF.UI.QL_PhieuTra"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Phiếu Trả" Height="620" Width="980"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <TextBlock Text="QUẢN LÝ PHIẾU TRẢ"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- FORM NHẬP LIỆU -->
        <Border Grid.Row="1"
                Background="#F9FBFF"
                CornerRadius="8"
                Padding="15"
                Margin="0,5"
                BorderBrush="#D0D7E2"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mã phiếu trả (chỉ đọc) -->
                <TextBlock Text="Mã phiếu trả:" Margin="5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Margin="5" Height="30"
                         IsReadOnly="True"
                         Background="#F0F0F0"
                         VerticalContentAlignment="Center"
                         Text="{Binding SelectedPhieuTra.MaPhieuTra}"/>

                <!-- Nhân viên - ComboBox với danh sách thực -->
                <TextBlock Text="Nhân viên:" Grid.Column="2" Margin="5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="3" Margin="5" Height="30"
                          ItemsSource="{Binding ListNhanVien}"
                          DisplayMemberPath="HoTen"
                          SelectedValuePath="MaNv"
                          SelectedValue="{Binding MaNhanVien, Mode=TwoWay}"/>

                <!-- Ngày trả -->
                <TextBlock Text="Ngày trả:" Grid.Row="1" Margin="5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <DatePicker Grid.Row="1" Grid.Column="1" Margin="5" Height="30"
                            SelectedDate="{Binding NgayTra, Mode=TwoWay}"/>

                <!-- Tiền phạt -->
                <TextBlock Text="Tổng tiền phạt:" Grid.Row="1" Grid.Column="2" Margin="5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="3" Margin="5" Height="30"
                         VerticalContentAlignment="Center"
                         Text="{Binding TongTienPhat, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Ghi chú -->
                <TextBlock Text="Ghi chú:" Grid.Row="2" Margin="5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="5" Height="30"
                         VerticalContentAlignment="Center"
                         Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Thanh tìm kiếm tự động (không cần nhấn nút) -->
                <TextBlock Text="Tìm kiếm:" Grid.Row="3" Margin="5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="5">
                    <TextBox Height="30"
                             VerticalContentAlignment="Center"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             x:Name="txtSearch"
                             Padding="5,0"/>
                    <!-- Placeholder: hiện khi Keyword trống -->
                    <TextBlock Text="🔎  Nhập mã phiếu, tên nhân viên hoặc ghi chú..."
                               VerticalAlignment="Center"
                               Margin="7,0,0,0"
                               Foreground="#AAAAAA"
                               FontStyle="Italic"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Keyword}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Keyword}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- BUTTON + DATAGRID -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BUTTONS -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button Content="➕ Thêm" Width="120" Height="35" Margin="5"
                        Background="#27AE60" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdthem}"/>

                <Button Content="✏️ Sửa" Width="120" Height="35" Margin="5"
                        Background="#F39C12" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdsua}"/>

                <Button Content="🗑 Xóa" Width="120" Height="35" Margin="5"
                        Background="#E74C3C" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdxoa}"/>

                <Button Content="🔄 Làm mới" Width="120" Height="35" Margin="5"
                        Background="#3498DB" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdlammoi}"/>
            </StackPanel>

            <!-- DATAGRID - bind vào ListHienThi và SelectedHienThi -->
            <DataGrid Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      ItemsSource="{Binding ListHienThi}"
                      SelectedItem="{Binding SelectedHienThi, Mode=TwoWay}"
                      Background="White"
                      BorderBrush="#D0D7E2"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F5F8FF">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã phiếu trả" Binding="{Binding MaPhieuTra}" Width="120"/>
                    <DataGridTextColumn Header="Nhân viên"    Binding="{Binding TenNhanVien}" Width="200"/>
                    <DataGridTextColumn Header="Ngày trả"     Binding="{Binding NgayTra, StringFormat={}{0:dd/MM/yyyy}}" Width="130"/>
                    <DataGridTextColumn Header="Tiền phạt"    Binding="{Binding TongTienPhat, StringFormat={}{0:N0} đ}" Width="130"/>
                    <DataGridTextColumn Header="Ghi chú"      Binding="{Binding GhiChu}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>