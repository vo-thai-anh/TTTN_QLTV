<Window x:Class="QLTV_WPF.UI.QL_PhieuTra"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Quản Lý Phiếu Trả" Height="600" Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <TextBlock Text="QUẢN LÝ PHIẾU TRẢ"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- FORM THÔNG TIN -->
        <Border Grid.Row="1"
                Background="#F9FBFF"
                CornerRadius="8"
                Padding="15"
                Margin="0,5"
                BorderBrush="#D0D7E2"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mã phiếu trả -->
                <TextBlock Text="Mã phiếu trả:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5"/>
                <TextBox Grid.Column="1" Margin="5" Height="30"
                         VerticalContentAlignment="Center"
                         IsReadOnly="True" Background="#F0F0F0"
                         Text="{Binding SelectedPhieuTra.MaPhieuTra, Mode=OneWay}"/>

                <!-- Nhân viên -->
                <TextBlock Text="Nhân viên:" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5"/>
                <ComboBox Grid.Column="3" Margin="5" Height="30"
                          ItemsSource="{Binding ListNhanVien}"
                          DisplayMemberPath="TenNhanVien"
                          SelectedValuePath="MaNhanVien"
                          SelectedValue="{Binding MaNhanVien}"/>

                <!-- Ngày trả -->
                <TextBlock Text="Ngày trả:" Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5"/>
                <DatePicker Grid.Row="1" Grid.Column="1" Margin="5"
                            SelectedDate="{Binding NgayTra}"/>

                <!-- Tổng tiền phạt -->
                <TextBlock Text="Tổng tiền phạt:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="3" Margin="5" Height="30"
                         VerticalContentAlignment="Center"
                         Text="{Binding TongTienPhat, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Ghi chú -->
                <TextBlock Text="Ghi chú:" Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="5" Height="30"
                         VerticalContentAlignment="Center"
                         Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}"/>

            </Grid>
        </Border>

        <!-- DANH SÁCH & BUTTON -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BUTTONS -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button Content="➕ Thêm" Width="120" Height="35" Margin="5"
                        Background="#27AE60" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdThemPT}"/>

                <Button Content="✏️ Sửa" Width="120" Height="35" Margin="5"
                        Background="#F39C12" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdSuaPT}"/>

                <Button Content="🗑 Xóa" Width="120" Height="35" Margin="5"
                        Background="#E74C3C" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdXoaPT}"/>

                <Button Content="🔄 Làm mới" Width="120" Height="35" Margin="5"
                        Background="#3498DB" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdLamMoi}"/>
            </StackPanel>

            <!-- DATAGRID -->
            <DataGrid Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      ItemsSource="{Binding ListPhieuTra}"
                      SelectedItem="{Binding SelectedPhieuTra}"
                      Background="White"
                      BorderBrush="#D0D7E2">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã phiếu trả" Binding="{Binding MaPhieuTra}"  Width="120"/>
                    <DataGridTextColumn Header="Nhân viên" Binding="{Binding MaNhanVienNavigation.TenNhanVien}" Width="200"/>
                    <DataGridTextColumn Header="Ngày trả" Binding="{Binding NgayTra, StringFormat=\{0:dd/MM/yyyy\}}" Width="140"/>
                    <DataGridTextColumn Header="Tiền phạt" Binding="{Binding TongTienPhat}" Width="100"/>
                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding GhiChu}" Width="*"/>
                </DataGrid.Columns>

            </DataGrid>
        </Grid>

    </Grid>
</Window>