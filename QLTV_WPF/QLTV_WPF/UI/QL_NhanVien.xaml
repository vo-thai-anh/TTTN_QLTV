<Window x:Class="QLTV_WPF.UI.QL_NhanVien"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Nhân Viên" Height="680" Width="950" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="QUẢN LÝ THÔNG TIN NHÂN VIÊN" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#EBEDEF" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🔍 Tìm nhân viên:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <TextBox x:Name="txtSearchNhanVien" Width="350" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0" ToolTip="Nhập tên hoặc số điện thoại nhân viên..."/>
                <Button x:Name="btnSearchNV" Content="Tìm kiếm" Width="100" Height="30" Background="#34495E" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#FDFEFE" CornerRadius="10" Padding="20" BorderBrush="#D0D7E2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Họ tên:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="txtHoTen" Grid.Column="1" Height="30" Margin="5"/>

                <TextBlock Text="Số điện thoại:" Grid.Row="1" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="txtSdt" Grid.Row="1" Grid.Column="1" Height="30" Margin="5"/>

                <TextBlock Text="Chức vụ:" Grid.Row="2" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox x:Name="cbChucVu" Grid.Row="2" Grid.Column="1" Height="30" Margin="5">
                    <ComboBoxItem Content="Thủ thư"/>
                    <ComboBoxItem Content="Quản lý"/>
                </ComboBox>

                <TextBlock Text="Email:" Grid.Column="3" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="txtEmail" Grid.Column="4" Height="30" Margin="5"/>

                <TextBlock Text="Mật khẩu:" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="txtMatKhau" Grid.Row="1" Grid.Column="4" Height="30" Margin="5"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
            <Button x:Name="btnAdd" Content="➕ Thêm" Width="110" Height="35" Margin="8" Background="#27AE60" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnUpdate" Content="✏️ Sửa" Width="110" Height="35" Margin="8" Background="#F39C12" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnDelete" Content="🗑 Xóa" Width="110" Height="35" Margin="8" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>
            <Button x:Name="btnRefresh" Content="🔄 Làm mới" Width="110" Height="35" Margin="8" Background="#3498DB" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <DataGrid x:Name="dgNhanVien" Grid.Row="4" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã NV" Binding="{Binding MaNhanVien}" Width="70"/>
                <DataGridTextColumn Header="Họ Tên" Binding="{Binding HoTen}" Width="200"/>
                <DataGridTextColumn Header="SĐT" Binding="{Binding Sdt}" Width="150"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                <DataGridTextColumn Header="Chức vụ" Binding="{Binding ChucVu}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>