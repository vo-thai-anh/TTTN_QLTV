<Window x:Class="QLTV_WPF.UI.QL_TacGia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QLTV_WPF.UI"
        mc:Ignorable="d"
        Title="QL_TacGia" Height="500" Width="850" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="QUẢN LÝ TÁC GIẢ"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,15"
                   Grid.Row="0"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,10">
            <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <TextBox x:Name="txtTimKiemTg" Width="300" Height="28" VerticalContentAlignment="Center"
             Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}"/>
            <Button x:Name="btnTimKiemTg" Content="🔍 Tìm kiếm" Width="100" Height="28" Margin="10,0,0,0" 
            Background="#34495E" Foreground="White" BorderThickness="0"
            Command="{Binding cmdTimKiem}"/>
        </StackPanel>
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,5" BorderBrush="#D0D7E2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Mã  Tác Giả:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtMaTg" Grid.Column="1" Height="28" Margin="5" IsReadOnly="True" Background="#F0F0F0"
                         Text="{Binding SelectedTacGia.MaTg, Mode=OneWay}"/>

                <TextBlock Text="Tên Tác Giả:" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtTenTg" Grid.Column="3" Height="28" Margin="5"
                         Text="{Binding Tentg, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Tiểu Sử:" Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtTieuSu" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="28" Margin="5"
                         Text="{Binding Tieusu, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Content="➕ Thêm" Width="90" Margin="5" Background="#27AE60" Foreground="White" Height="30"
                        Command="{Binding cmdthemtg}"/>
                <Button Content="✏️ Sửa" Width="90" Margin="5" Background="#F39C12" Foreground="White" Height="30"
                        Command="{Binding cmdsuatg}"/>
                <Button Content="🗑 Xóa" Width="90" Margin="5" Background="#E74C3C" Foreground="White" Height="30"
                        Command="{Binding cmdxoatg}"/>
                <Button Content="🔄 Làm mới" Width="90" Margin="5" Background="#3498DB" Foreground="White" Height="30"
                        Command="{Binding cmdlammoi}"/>
            </StackPanel>

            <DataGrid x:Name="dgTacGia" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" IsReadOnly="True"
                      ItemsSource="{Binding ListTacGia}"
                      SelectedItem="{Binding SelectedTacGia}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Tác Giả" Binding="{Binding MaTg}" Width="100"/>
                    <DataGridTextColumn Header="Tên Tác Giả" Binding="{Binding TenTg}" Width="200"/>
                    <DataGridTextColumn Header="Tiểu Sử" Binding="{Binding TieuSu}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>