<Window x:Class="QLTV_WPF.UI.QL_DocGia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Độc Giả" Height="700" Width="950" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="QUẢN LÝ THÔNG TIN ĐỘC GIẢ" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#EBEDEF" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🔍 Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <TextBox Width="350" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0" 
                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Tìm" Width="80" Height="30" Background="#34495E" Foreground="White" Command="{Binding cmdSearch}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#FDFEFE" CornerRadius="10" Padding="20" BorderBrush="#D0D7E2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Mã Độc Giả:" VerticalAlignment="Center" Margin="0,5" Foreground="Gray"/>
                <TextBox Grid.Column="1" Height="30" Margin="5" IsReadOnly="True" Background="#F0F0F0"
                         Text="{Binding SelectedDocGia.MaDocGia, Mode=OneWay}"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5">
                    <TextBlock Text="Họ tên"/>
                    <TextBlock Text="*" Foreground="Red" Margin="2,0,0,0"/>
                </StackPanel>
                <TextBox Grid.Row="1" Grid.Column="1" Height="30" Margin="5" Text="{Binding HoTen, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5">
                    <TextBlock Text="Số điện thoại"/>
                    <TextBlock Text="*" Foreground="Red" Margin="2,0,0,0"/>
                </StackPanel>
                <TextBox Grid.Row="1" Grid.Column="4" Height="30" Margin="5" MaxLength="10"
                         Text="{Binding Sdt, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Email:" Grid.Row="2" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="2" Grid.Column="1" Height="30" Margin="5" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Địa chỉ:" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox Grid.Row="2" Grid.Column="4" Height="30" Margin="5" Text="{Binding DiaChi, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
            <Button Content="➕ Thêm" Width="110" Height="35" Margin="8" Background="#27AE60" Foreground="White" FontWeight="Bold" Command="{Binding cmdThem}"/>
            <Button Content="✏️ Sửa" Width="110" Height="35" Margin="8" Background="#F39C12" Foreground="White" FontWeight="Bold" Command="{Binding cmdSua}"/>
            <Button Content="🗑 Xóa" Width="110" Height="35" Margin="8" Background="#E74C3C" Foreground="White" FontWeight="Bold" Command="{Binding cmdXoa}"/>
            <Button Content="🔄 Làm mới" Width="110" Height="35" Margin="8" Background="#3498DB" Foreground="White" FontWeight="Bold" Command="{Binding cmdLamMoi}"/>
        </StackPanel>

        <DataGrid Grid.Row="4" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                  ItemsSource="{Binding ListDocGia}" SelectedItem="{Binding SelectedDocGia}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã ĐG" Binding="{Binding MaDocGia}" Width="70"/>
                <DataGridTextColumn Header="Họ Tên" Binding="{Binding HoTen}" Width="200"/>
                <DataGridTextColumn Header="SĐT" Binding="{Binding Sdt}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>