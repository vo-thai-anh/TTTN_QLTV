<Window x:Class="QLTV_WPF.UI.QL_LoaiSach"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QLTV_WPF.UI"
        mc:Ignorable="d"
        Title="Quản Lý Loại Sách" Height="500" Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="QUẢN LÝ LOẠI SÁCH"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                Background="#F9FBFF"
                CornerRadius="8"
                Padding="15"
                Margin="0,5"
                BorderBrush="#D0D7E2"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Mã loại:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5"/>
                <TextBox x:Name="txtMaLoai" Grid.Column="1" Height="30" Margin="5" 
                         VerticalContentAlignment="Center" IsReadOnly="True" Background="#F0F0F0"
                         Text="{Binding SelectedLoaiSach.MaLoai, Mode=OneWay}"/>

                <TextBlock Text="Tên loại:" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="15,5,5,5"/>
                <TextBox x:Name="txtTenLoai" Grid.Column="3" Height="30" Margin="5" 
                         VerticalContentAlignment="Center"
                         Text="{Binding Tenloai, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Mô tả:" Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold" Margin="5"/>
                <TextBox x:Name="txtMoTa" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="30" Margin="5" 
                         VerticalContentAlignment="Center"
                         Text="{Binding Mota, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button Content="➕ Thêm" Width="100" Height="35" Margin="5" 
                        Background="#27AE60" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdthemls}"/>

                <Button Content="✏️ Sửa" Width="100" Height="35" Margin="5" 
                        Background="#F39C12" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdsuals}"/>

                <Button Content="🗑 Xóa" Width="100" Height="35" Margin="5" 
                        Background="#E74C3C" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdxoals}"/>

                <Button Content="🔄 Làm mới" Width="100" Height="35" Margin="5" 
                        Background="#3498DB" Foreground="White" FontWeight="Bold"
                        Command="{Binding cmdlammoi}"/>
            </StackPanel>

            <DataGrid x:Name="dgLoaiSach" 
                      Grid.Row="1"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      SelectionMode="Single" 
                      IsReadOnly="True"
                      ItemsSource="{Binding ListloaiSach}"
                      SelectedItem="{Binding SelectedLoaiSach}"
                      Background="White"
                      BorderBrush="#D0D7E2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã loại" Binding="{Binding MaLoai}" Width="100"/>
                    <DataGridTextColumn Header="Tên loại" Binding="{Binding TenLoai}" Width="250"/>
                    <DataGridTextColumn Header="Mô tả" Binding="{Binding MoTa}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>