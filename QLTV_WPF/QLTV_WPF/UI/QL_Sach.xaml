<Window x:Class="QLTV_WPF.UI.QL_Sach"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Đầu Sách" Height="650" Width="900" WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <TextBlock Text="QUẢN LÝ THÔNG TIN SÁCH"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- FORM -->
        <Border Grid.Row="1" Background="#FDFEFE" CornerRadius="10" Padding="20" BorderBrush="#D0D7E2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Tên sách -->
                <TextBlock Text="Tên sách:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Margin="5"
                         Text="{Binding Tensach}"
                         IsEnabled="{Binding IsQuanLy}"/>

                <!-- Tác giả -->
                <Button Grid.Column="2" Content="✍️ Tác giả"
                        Width="90"
                        Margin="5,0,0,0"
                        Command="{Binding cmdQuanLyTacGia}"
                        IsEnabled="{Binding IsQuanLy}"/>

                <!-- Số lượng -->
                <TextBlock Text="Số lượng:" Grid.Column="4" VerticalAlignment="Center"/>
                <TextBox Grid.Column="5" Margin="5"
                         Text="{Binding Soluong}"
                         IsEnabled="{Binding IsQuanLy}"/>

                <!-- Năm XB -->
                <TextBlock Text="Năm XB:" Grid.Row="1"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="5"
                         Text="{Binding Namxb}"
                         IsEnabled="{Binding IsQuanLy}"/>

                <!-- Số trang -->
                <TextBlock Text="Số trang:" Grid.Row="1" Grid.Column="4"/>
                <TextBox Grid.Row="1" Grid.Column="5" Margin="5"
                         Text="{Binding Sotrang}"
                         IsEnabled="{Binding IsQuanLy}"/>

                <!-- Loại sách -->
                <TextBlock Text="Loại sách:" Grid.Row="2"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="5"
                          ItemsSource="{Binding ListLoaiSach}"
                          DisplayMemberPath="TenLoai"
                          SelectedValuePath="MaLoai"
                          SelectedValue="{Binding Maloai}"
                          IsEnabled="{Binding IsQuanLy}"/>

                <!-- NXB -->
                <TextBlock Text="Nhà XB:" Grid.Row="2" Grid.Column="4"/>
                <ComboBox Grid.Row="2" Grid.Column="5" Margin="5"
                          ItemsSource="{Binding ListNXB}"
                          DisplayMemberPath="TenNxb"
                          SelectedValuePath="MaNxb"
                          SelectedValue="{Binding Manxb}"
                          IsEnabled="{Binding IsQuanLy}"/>

                <!-- Tóm tắt -->
                <TextBlock Text="Tóm tắt:" Grid.Row="3"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5"
                         Margin="5"
                         Height="60"
                         Text="{Binding Tomtat}"
                         IsEnabled="{Binding IsQuanLy}"/>
            </Grid>
        </Border>

        <!-- BUTTON -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">

            <Button Content="➕ Thêm"
                    Width="90" Margin="5"
                    Command="{Binding cmdthemsach}"
                    IsEnabled="{Binding IsQuanLy}"/>

            <Button Content="✏️ Sửa"
                    Width="90" Margin="5"
                    Command="{Binding cmdsuasach}"
                    IsEnabled="{Binding IsQuanLy}"/>

            <Button Content="🗑 Xóa"
                    Width="90" Margin="5"
                    Command="{Binding cmdxoasach}"
                    IsEnabled="{Binding IsQuanLy}"/>

            <Button Content="🔄 Làm mới"
                    Width="90" Margin="5"
                    Command="{Binding cmdlammoi}"/>

            <Button Content="📚 Nhập Kho Mượn"
                    Width="140" Margin="5"
                    Command="{Binding cmdMoKhoSach}"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Label -->
            <TextBlock Text="Tìm kiếm sách:"
               VerticalAlignment="Center"
               FontWeight="Bold"
               FontSize="14"
               Margin="0,0,10,0"/>

            <!-- Ô tìm kiếm -->
            <Grid Grid.Column="1">
                <TextBox Height="35"
                 VerticalContentAlignment="Center"
                 Padding="5,0"
                 FontSize="14"
                 Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>
                <!-- Placeholder -->
                <TextBlock Text=""
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"
                   Foreground="#AAAAAA"
                   FontStyle="Italic"
                   IsHitTestVisible="False">
                    
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Keyword}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Keyword}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            
        </Grid>
        <!-- TABLE -->
        <DataGrid Grid.Row="4"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding ListSach}"
                  SelectedItem="{Binding SelectedSach}"
                  IsReadOnly="True">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding MaSach}" Width="50"/>
                <DataGridTextColumn Header="Tên" Binding="{Binding TenSach}" Width="200"/>
                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="80"/>
                <DataGridTextColumn Header="Loại" Binding="{Binding TenLoai}" Width="150"/>
                <DataGridTextColumn Header="NXB" Binding="{Binding TenNXB}" Width="150"/>
                <DataGridTextColumn Header="Tác giả" Binding="{Binding TenTacGia}" Width="200"/>
                <DataGridTextColumn Header="Tóm tắt" Binding="{Binding TomTat}" Width="*"/>
            </DataGrid.Columns>

        </DataGrid>
    </Grid>
</Window>