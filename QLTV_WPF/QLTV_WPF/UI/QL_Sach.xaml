<Window x:Class="QLTV_WPF.UI.QL_Sach"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Đầu Sách" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="QUẢN LÝ THÔNG TIN SÁCH" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#FDFEFE" CornerRadius="10" Padding="20" BorderBrush="#D0D7E2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Tên sách:" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="txtTenSach" Grid.Column="1" Height="30" Margin="5"/>

                <TextBlock Text="Năm XB:" Grid.Row="1" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="txtNamXB" Grid.Row="1" Grid.Column="1" Height="30" Margin="5"/>

                <TextBlock Text="Loại sách:" Grid.Row="2" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox x:Name="cbLoaiSach" Grid.Row="2" Grid.Column="1" Height="30" Margin="5" 
                          DisplayMemberPath="TenLoai" SelectedValuePath="MaLoai"/>

                <TextBlock Text="Số lượng:" Grid.Column="3" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="txtSoLuong" Grid.Column="4" Height="30" Margin="5"/>

                <TextBlock Text="Số trang:" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="0,5"/>
                <TextBox x:Name="txtSoTrang" Grid.Row="1" Grid.Column="4" Height="30" Margin="5"/>

                <TextBlock Text="Nhà XB:" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Margin="0,5"/>
                <ComboBox x:Name="cbNXB" Grid.Row="2" Grid.Column="4" Height="30" Margin="5"
                          DisplayMemberPath="TenNXB" SelectedValuePath="MaNXB"/>

                <TextBlock Text="Tóm tắt:" Grid.Row="3" VerticalAlignment="Top" Margin="0,10"/>
                <TextBox x:Name="txtTomTat" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Height="60" Margin="5" 
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
            <Button Content="➕ Thêm" Width="100" Height="35" Margin="8" Background="#27AE60" Foreground="White" FontWeight="Bold"/>
            <Button Content="✏️ Sửa" Width="100" Height="35" Margin="8" Background="#F39C12" Foreground="White" FontWeight="Bold"/>
            <Button Content="🗑 Xóa" Width="100" Height="35" Margin="8" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>
            <Button Content="🔄 Làm mới" Width="100" Height="35" Margin="8" Background="#3498DB" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <DataGrid x:Name="dgSach" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" ItemsSource="{Binding ListSach}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding MaSach}" Width="50"/>
                <DataGridTextColumn Header="Tên Sách" Binding="{Binding TenSach}" Width="200"/>
                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="80"/>
                <DataGridTextColumn Header="Loại" Binding="{Binding TenLoai}" Width="120"/>
                <DataGridTextColumn Header="NXB" Binding="{Binding TenNXB}" Width="120"/>
                <DataGridTextColumn Header="Tóm tắt" Binding="{Binding TomTat}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>