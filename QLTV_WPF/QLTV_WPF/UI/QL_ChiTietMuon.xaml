<Window x:Class="QLTV_WPF.UI.QL_ChiTietMuon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Chi Tiết Mượn (Giỏ Hàng)" Height="550" Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="CHI TIẾT SÁCH MƯỢN"
                   FontSize="24" FontWeight="Bold" Foreground="#2C3E50"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#F9FBFF" CornerRadius="8" Padding="15" BorderBrush="#D0D7E2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Mã phiếu:" Margin="5" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Column="1" Height="30" Margin="5"
                         Text="{Binding MaPhieuMuon}"
                         IsReadOnly="True" Background="#F0F0F0" VerticalContentAlignment="Center"/>

                <TextBlock Text="Mã sách vật lý:" Grid.Column="2" Margin="5" VerticalAlignment="Center" FontWeight="SemiBold"/>

                <TextBox Grid.Column="3" Height="30" Margin="5"
                         Text="{Binding MaSachMuon, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Tiền phạt (nếu có):" Grid.Row="1" Margin="5" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Row="1" Grid.Column="1" Height="30" Margin="5"
                         Text="{Binding TienPhat, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Lý do phạt:" Grid.Row="1" Grid.Column="2" Margin="5" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Row="1" Grid.Column="3" Height="30" Margin="5"
                         Text="{Binding LyDoPhat, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">

            <Button Content="➕ Quét thêm (Enter)" Width="150" Height="35" Margin="5"
                    Background="#27AE60" Foreground="White" FontWeight="Bold" IsDefault="True"
                    Command="{Binding cmdThemCT}"/>

            <Button Content="📥 Nhận trả sách" Width="130" Height="35" Margin="5"
                    Background="#F39C12" Foreground="White" FontWeight="Bold"
                    Command="{Binding cmdSuaCT}"/>

            <Button Content="🗑 Xóa nhầm" Width="110" Height="35" Margin="5"
                    Background="#E74C3C" Foreground="White" FontWeight="Bold"
                    Command="{Binding cmdXoaCT}"/>

            <Button Content="🔄 Làm mới" Width="110" Height="35" Margin="5"
                    Background="#3498DB" Foreground="White" FontWeight="Bold"
                    Command="{Binding cmdLamMoiCT}"/>
        </StackPanel>

        <DataGrid Grid.Row="3"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding List}"
                  SelectedItem="{Binding Selected}"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  Background="White"
                  BorderBrush="#D0D7E2">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã Phiếu" Binding="{Binding MaPhieuMuon}" Width="80"/>
                <DataGridTextColumn Header="Mã Cuốn Sách" Binding="{Binding MaSachMuon}" Width="100"/>
                <DataGridTextColumn Header="Ngày trả thực tế" Binding="{Binding NgayTraThucTe, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140"/>
                <DataGridTextColumn Header="Tiền phạt" Binding="{Binding TienPhat, StringFormat={}{0:N0} đ}" Width="100"/>
                <DataGridTextColumn Header="Lý do" Binding="{Binding LyDoPhat}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>