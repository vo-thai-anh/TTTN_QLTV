<Window x:Class="QLTV_WPF.UI.QL_ChiTietMuon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Chi Tiết Mượn" Height="550" Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TIÊU ĐỀ -->
        <TextBlock Text="CHI TIẾT SÁCH MƯỢN"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <!-- FORM -->
        <Border Grid.Row="1"
                Background="#F9FBFF"
                CornerRadius="8"
                Padding="15"
                BorderBrush="#D0D7E2"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mã phiếu -->
                <TextBlock Text="Mã phiếu:" Margin="5" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Height="30" Margin="5"
                         Text="{Binding SelectedCT.MaPhieuMuon}"
                         IsReadOnly="True"
                         Background="#F0F0F0"
                         VerticalContentAlignment="Center"/>

                <!-- Mã sách -->
                <TextBlock Text="Mã sách:" Grid.Column="2" Margin="5" VerticalAlignment="Center"/>
                <TextBox Grid.Column="3" Height="30" Margin="5"
                         Text="{Binding SelectedCT.MaSachMuon, Mode=TwoWay}"
                         VerticalContentAlignment="Center"/>

                <!-- Ngày trả -->
                <TextBlock Text="Ngày trả:" Grid.Row="1" Margin="5" VerticalAlignment="Center"/>
                <DatePicker Grid.Row="1" Grid.Column="1" Margin="5"
                            SelectedDate="{Binding SelectedCT.NgayTraThucTe, Mode=TwoWay}"/>

                <!-- Tiền phạt -->
                <TextBlock Text="Tiền phạt:" Grid.Row="1" Grid.Column="2" Margin="5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="3" Height="30" Margin="5"
                         Text="{Binding SelectedCT.TienPhat, Mode=TwoWay}"
                         VerticalContentAlignment="Center"/>

                <!-- Lý do -->
                <TextBlock Text="Lý do:" Grid.Row="2" Margin="5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                         Height="30" Margin="5"
                         Text="{Binding SelectedCT.LyDoPhat, Mode=TwoWay}"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- BUTTON -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10">

            <Button Content="➕ Thêm" Width="110" Height="35" Margin="5"
                    Background="#27AE60" Foreground="White"
                    FontWeight="Bold"
                    Command="{Binding cmdThemCT}"/>

            <Button Content="✏️ Sửa" Width="110" Height="35" Margin="5"
                    Background="#F39C12" Foreground="White"
                    FontWeight="Bold"
                    Command="{Binding cmdSuaCT}"/>

            <Button Content="🗑 Xóa" Width="110" Height="35" Margin="5"
                    Background="#E74C3C" Foreground="White"
                    FontWeight="Bold"
                    Command="{Binding cmdXoaCT}"/>

            <Button Content="🔄 Làm mới" Width="110" Height="35" Margin="5"
                    Background="#3498DB" Foreground="White"
                    FontWeight="Bold"
                    Command="{Binding cmdLamMoiCT}"/>
        </StackPanel>

        <!-- DATAGRID -->
        <DataGrid Grid.Row="3"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding ListCT}"
                  SelectedItem="{Binding SelectedCT}"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Background="White"
                  BorderBrush="#D0D7E2">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã phiếu" Binding="{Binding MaPhieuMuon}" Width="100"/>
                <DataGridTextColumn Header="Mã sách" Binding="{Binding MaSachMuon}" Width="100"/>
                <DataGridTextColumn Header="Ngày trả"
                                    Binding="{Binding NgayTraThucTe, StringFormat={}{0:dd/MM/yyyy}}"
                                    Width="140"/>
                <DataGridTextColumn Header="Tiền phạt" Binding="{Binding TienPhat}" Width="120"/>
                <DataGridTextColumn Header="Lý do" Binding="{Binding LyDoPhat}" Width="*"/>
            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>