<Window x:Class="QLTV_WPF.UI.QL_NhaXuatBan"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QLTV_WPF.UI"
        mc:Ignorable="d"
        Title="QL_NhaXuatBan" Height="550" Width="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="QUẢN LÝ NHÀ XUẤT BẢN"
                   FontSize="24" FontWeight="Bold" Foreground="#2C3E50"
                   HorizontalAlignment="Center" Margin="0,0,0,10" Grid.Row="0"/>

        <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,5,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Tìm kiếm NXB:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" Foreground="#34495E"/>
                <TextBox x:Name="txtTimKiem" Width="300" Height="30" VerticalContentAlignment="Center" Padding="5,0"
                         Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}"/>
                <Button x:Name="btnTimKiem" Content="🔍 Tìm kiếm" Width="100" Height="30" Margin="10,0,0,0" 
                        Background="#34495E" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Command="{Binding cmdTimKiem}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,5" BorderBrush="#D0D7E2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Mã Nhà Xuất Bản:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtMaNXB" Grid.Column="1" Height="28" Margin="5"
                         IsReadOnly="True" Background="#F0F0F0"
                         Text="{Binding Manxb, Mode=OneWay}"/>

                <TextBlock Text="Tên Nhà Xuất Bản:" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="10,0,5,0"/>
                <TextBox x:Name="txtTenNXB" Grid.Column="3" Height="28" Margin="5"
                         Text="{Binding Tennxb, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Địa Chỉ:" Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtDiaChi" Grid.Column="1" Height="28" Margin="5" Grid.Row="1"
                         Text="{Binding Diachi, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="SDT:" Grid.Column="2" Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold" Margin="10,0,5,0"/>
                <TextBox x:Name="txtSDT" Grid.Column="3" Height="28" Margin="5" Grid.Row="1"
                         Text="{Binding Sdt, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Content="➕ Thêm" Width="90" Margin="5" Background="#27AE60" Foreground="White" BorderThickness="0" Height="30" Command="{Binding cmdthemnxb}"/>
                <Button Content="✏️ Sửa" Width="90" Margin="5" Background="#F39C12" Foreground="White" BorderThickness="0" Height="30" Command="{Binding cmdsuanxb}"/>
                <Button Content="🗑 Xóa" Width="90" Margin="5" Background="#E74C3C" Foreground="White" BorderThickness="0" Height="30" Command="{Binding cmdxoanxb}"/>
                <Button Content="🔄 Làm mới" Width="90" Margin="5" Background="#3498DB" Foreground="White" BorderThickness="0" Height="30" Command="{Binding cmdlammoi}"/>
            </StackPanel>

            <DataGrid x:Name="dgNhaXuatBan"
                      Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" IsReadOnly="True"
                      ItemsSource="{Binding ListNhaXuatBan}"
                      SelectedItem="{Binding SelectedNXB}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã NXB" Binding="{Binding MaNxb}" Width="100"/>
                    <DataGridTextColumn Header="Tên Nhà Xuất Bản" Binding="{Binding TenNxb}" Width="200"/>
                    <DataGridTextColumn Header="Địa Chỉ" Binding="{Binding DiaChi}" Width="200"/>
                    <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding Sdt}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>