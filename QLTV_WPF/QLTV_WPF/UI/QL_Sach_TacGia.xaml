<Window x:Class="QLTV_WPF.UI.QL_Sach_TacGia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn Tác Giả Cho Sách" Height="400" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblTenSach" Text="Sách: [Tên Sách]" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid x:Name="dgTacGia" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding ListTacGiaChon}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Chọn" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                <DataGridTextColumn Header="Tên Tác Giả" Binding="{Binding TenTg}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="💾 Lưu thay đổi" Width="120" Height="35" Background="#27AE60" Foreground="White" FontWeight="Bold" Click="btnLuu_Click"/>
            <Button Content="❌ Đóng" Width="80" Height="35" Margin="10,0,0,0" Click="btnDong_Click"/>
        </StackPanel>
    </Grid>
</Window>