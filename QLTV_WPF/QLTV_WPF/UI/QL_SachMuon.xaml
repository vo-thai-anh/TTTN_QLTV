<Window x:Class="QLTV_WPF.UI.QL_SachMuon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Kho Sách (Sách Mượn)" Height="500" Width="750" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="QUẢN LÝ CUỐN SÁCH VẬT LÝ" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="#FDFEFE" CornerRadius="8" Padding="15" BorderBrush="#D0D7E2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Đầu sách:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox Grid.Column="1" Height="30" Margin="5"
                          ItemsSource="{Binding ListSach}" DisplayMemberPath="TenSach" SelectedValuePath="MaSach"
                          SelectedValue="{Binding Masach, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Trạng thái:" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Margin="15,0,0,0"/>
                <ComboBox Grid.Column="3" Height="30" Margin="5"
                          ItemsSource="{Binding ListTrangThai}" DisplayMemberPath="TenTT" SelectedValuePath="MaTT"
                          SelectedValue="{Binding Trangthai, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Tình trạng vật lý:" Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,15,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="30" Margin="5,20,5,5" VerticalContentAlignment="Center"
                         Text="{Binding Tinhtrang, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
            <Button Content="➕ Thêm" Width="90" Height="35" Margin="5" Background="#27AE60" Foreground="White" FontWeight="Bold" Command="{Binding cmdthemsachmuon}"/>
            <Button Content="✏️ Sửa" Width="90" Height="35" Margin="5" Background="#F39C12" Foreground="White" FontWeight="Bold" Command="{Binding cmdsuasachmuon}"/>
            <Button Content="🗑 Xóa" Width="90" Height="35" Margin="5" Background="#E74C3C" Foreground="White" FontWeight="Bold" Command="{Binding cmdxoasachmuon}"/>
            <Button Content="🔄 Làm mới" Width="90" Height="35" Margin="5" Background="#3498DB" Foreground="White" FontWeight="Bold" Command="{Binding cmdlammoi}"/>
        </StackPanel>

        <DataGrid x:Name="dgSachMuon" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                  ItemsSource="{Binding ListSachMuon}" SelectedItem="{Binding SelectedSachMuon}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã Vạch" Binding="{Binding MaSachMuon}" Width="80"/>
                <DataGridTextColumn Header="Mã Đầu Sách" Binding="{Binding MaSach}" Width="100"/>
                <DataGridTextColumn Header="Trạng thái mượn" Binding="{Binding TenTrangThai}" Width="120" FontWeight="Bold"/>
                <DataGridTextColumn Header="Tình trạng vật lý" Binding="{Binding TinhTrang}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>