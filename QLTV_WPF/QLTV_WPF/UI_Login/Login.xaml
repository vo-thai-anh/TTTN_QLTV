<Window x:Class="QLTV_WPF.UI.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập hệ thống thư viện"
        Height="400"
        Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid>
        <Border Width="350"
                Height="260"
                Background="White"
                CornerRadius="12"
                Padding="20"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>

                <TextBlock Text="ĐĂNG NHẬP HỆ THỐNG"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 20"/>

                <TextBlock Text="Tài khoản"/>
                <TextBox x:Name="txtUsername"
                         Height="32"
                         Margin="0 5 0 10"/>

                <TextBlock Text="Mật khẩu"/>
                <PasswordBox x:Name="txtPassword"
                             Height="32"
                             Margin="0 5 0 20"/>

                <Button Content="Đăng nhập"
                        Height="35"
                        Background="#4CAF50"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BtnLogin_Click"/>

                <TextBlock x:Name="txtMessage"
                           Foreground="Red"
                           Margin="0 10 0 0"
                           TextAlignment="Center"/>

            </StackPanel>

        </Border>
    </Grid>
</Window>