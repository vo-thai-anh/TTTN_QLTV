<Window x:Class="QLTV_WPF.UI_MeNu.MeNu_NV"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hệ thống Quản lý Thư viện - Nhân viên"
        Height="500"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#2C3E50"
                Height="60">

            <TextBlock Text="📚 HỆ THỐNG QUẢN LÝ THƯ VIỆN - NHÂN VIÊN"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>
        </Border>


        <!-- SIDEBAR MENU -->
        <Border DockPanel.Dock="Left"
                Width="220"
                Background="#34495E">

            <StackPanel Margin="10">

                <TextBlock Text="MENU CHỨC NĂNG"
                           Foreground="White"
                           FontSize="16"
                           Margin="10"/>


                <Button Content="📖 Quản lý Sách"
                        Height="40"
                        Margin="5"
                        Click="MenuItem_ClickSach"/>

                <Button Content="👤 Quản lý Độc Giả"
                        Height="40"
                        Margin="5"
                        Click="QLDocGia_Click"/>

                <Button Content="📄 Lập Phiếu Mượn"
                        Height="40"
                        Margin="5"
                        Click="QLPhieuMuon_Click"/>

                <Button Content="📄 Lập Phiếu Trả"
                        Height="40"
                        Margin="5"
                        Click="QLPhieuTra_Click"/>

                <Button Content="📋 Chi Tiết Mượn"
                        Height="40"
                        Margin="5"
                        Click="QLChiTietMuon_Click"/>

                <Button Content="📚 Sách Đang Mượn"
                        Height="40"
                        Margin="5"
                        Click="MenuItem_ClickSachMuon"/>

                <Separator Margin="10"/>

                <Button Content="🚪 Đăng xuất"
                        Height="40"
                        Margin="5"
                        Background="#E74C3C"
                        Foreground="White"
                        Click="btnLogout_Click"/>

            </StackPanel>

        </Border>


        <!-- MAIN CONTENT -->
        <Grid>

            <TextBlock Text="Chào mừng bạn đến hệ thống quản lý thư viện"
                       FontSize="22"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Grid>

    </DockPanel>

</Window>