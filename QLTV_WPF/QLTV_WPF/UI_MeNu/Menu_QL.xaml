<Window x:Class="QLTV_WPF.UI_MeNu.MeNu_QL"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hệ thống Quản lý Thư viện - Quản lý"
        Height="520"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">

    <DockPanel>

        <!-- HEADER -->
        <Border DockPanel.Dock="Top"
                Background="#1ABC9C"
                Height="60">

            <TextBlock x:Name="txtUser"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>
        </Border>


        <!-- SIDEBAR MENU -->
        <Border DockPanel.Dock="Left"
                Width="250"
                Background="#2C3E50">

            <ScrollViewer>

                <StackPanel Margin="10">

                    <TextBlock Text="MENU QUẢN LÝ"
                               Foreground="White"
                               FontSize="16"
                               Margin="10"/>


                    <!-- DANH MỤC SÁCH -->
                    <TextBlock Text="Danh mục sách"
                               Foreground="White"
                               Margin="10,15,0,5"/>

                    <Button Content="📚 Quản lý Loại Sách"
                            Height="40"
                            Margin="5"
                            Click="MenuItemLS_Click"/>

                    <Button Content="📖 Quản lý Sách"
                            Height="40"
                            Margin="5"
                            Click="MenuItem_ClickSach"/>

                    <Button Content="✍️ Quản lý Tác Giả"
                            Height="40"
                            Margin="5"
                            Click="QLTacGia_Click"/>

                    <Button Content="🏢 Quản lý Nhà Xuất Bản"
                            Height="40"
                            Margin="5"
                            Click="QLNhaXuatBan_Click"/>


                    <!-- ĐỐI TƯỢNG -->
                    <TextBlock Text="Quản lý đối tượng"
                               Foreground="White"
                               Margin="10,15,0,5"/>

                    <Button Content="👤 Quản lý Độc Giả"
                            Height="40"
                            Margin="5"
                            Click="QLDocGia_Click"/>

                    <Button Content="🧑‍💼 Quản lý Nhân Viên"
                            Height="40"
                            Margin="5"
                            Click="QLNhanVien_Click"/>


                    <!-- NGHIỆP VỤ -->
                    <TextBlock Text="Nghiệp vụ mượn trả"
                               Foreground="White"
                               Margin="10,15,0,5"/>

                    <Button Content="📄 Lập Phiếu Mượn"
                            Height="40"
                            Margin="5"
                            Click="QLPhieuMuon_Click"/>

                    <Button Content="📄 Lập Phiếu Trả"
                            Height="40"
                            Margin="5"
                            Click="QLPhieuTra_Click"/>

                    <Button Content="📋 Chi Tiết Mượn"
                            Height="40"
                            Margin="5"
                            Click="QLChiTietMuon_Click"/>

                    <Button Content="📚 Sách Đang Mượn"
                            Height="40"
                            Margin="5"
                            Click="MenuItem_ClickSachMuon"/>


                    <Separator Margin="10"/>

                    <!-- LOGOUT -->
                    <Button Content="🚪 Đăng xuất"
                            Height="40"
                            Margin="5"
                            Background="#E74C3C"
                            Foreground="White"
                            Click="btnLogout_Click"/>

                </StackPanel>

            </ScrollViewer>

        </Border>


        <!-- MAIN CONTENT -->
        <Grid>

            <TextBlock Text="Chào mừng Quản lý đến hệ thống thư viện"
                       FontSize="24"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Grid>

    </DockPanel>

</Window>