<Window x:Class="QuanLyThuVien_WPF.UI.QL_LoaiSach"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mylocal="clr-namespace:QuanLyThuVien_WPF.Models_API"
        mc:Ignorable="d"
        Title="Quản lý loại sách"
        Height="500"
        Width="900"
        Background="#F5F7FA">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- ======= TITLE ======= -->
        <TextBlock Text="QUẢN LÝ LOẠI SÁCH"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <!-- ======= INPUT AREA ======= -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,5"
                BorderBrush="#D0D7E2"
                BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Mã loại -->
                <TextBlock Text="Mã loại:"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtMaLoai"
                         Grid.Column="1"
                         Height="28"
                         Margin="5"/>

                <!-- Tên loại -->
                <TextBlock Text="Tên loại:"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtTenLoai"
                         Grid.Column="3"
                         Height="28"
                         Margin="5"/>

                <!-- Mô tả -->
                <TextBlock Text="Mô tả:"
                           Grid.Row="1"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="txtMoTa"
                         Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         Height="28"
                         Margin="5"/>

            </Grid>
        </Border>

        <!-- ======= DATAGRID + BUTTON ======= -->
        <Grid Grid.Row="2" Margin="0,10,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- BUTTON AREA -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">

                <Button Content="➕ Thêm"
                        Width="90"
                        Margin="5"
                        Background="#27AE60"
                        Foreground="White"/>

                <Button Content="✏️ Sửa"
                        Width="90"
                        Margin="5"
                        Background="#F39C12"
                        Foreground="White"/>

                <Button Content="🗑 Xóa"
                        Width="90"
                        Margin="5"
                        Background="#E74C3C"
                        Foreground="White"/>

                <Button Content="🔄 Làm mới"
                        Width="90"
                        Margin="5"
                        Background="#3498DB"
                        Foreground="White"/>

            </StackPanel>

            <!-- DATAGRID -->
            <DataGrid x:Name="dgLoaiSach"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      Background="White"
                      ItemsSource="{Binding ListloaiSach}">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Mã loại"
                                        Binding="{Binding Maloai}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Tên loại"
                                        Binding="{Binding Tenloai}"
                                        Width="250"/>

                    <DataGridTextColumn Header="Mô tả"
                                        Binding="{Binding Mota}"
                                        Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </Grid>
</Window>